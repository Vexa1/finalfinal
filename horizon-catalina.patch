+extern "C" fn first_rect_for_character_range(
+    this: &AnyObject,
+    _: Sel,
+    range: NSRange,
+    _: *mut NSRange,
+) -> NSRect {
+    let frame = get_frame(this);
+    with_input_handler(this, |input_handler| {
+        input_handler.bounds_for_range(range.to_range()?)
+    })
+    .flatten()
+    .map_or(
+        NSRect::new(NSPoint::new(0., 0.), NSSize::new(0., 0.)),
+        |bounds| {
