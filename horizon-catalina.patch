+        let (tx, rx) = oneshot::channel();
+        let answers: Vec<String> = answers.iter().map(|s| s.label().to_string()).collect();
+        self.prompts
+            .borrow_mut()
+            .multiple_choice
+            .push_back(TestPrompt {
+                msg: msg.to_string(),
+                detail: detail.map(|s| s.to_string()),
+                answers,
+                tx,
+            });
+        rx
+    }
