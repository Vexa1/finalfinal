+    pub(crate) fn new_internal(
+        device: Retained<ProtocolObject<dyn MTLDevice>>,
+        layer: Option<Retained<CAMetalLayer>>,
+        opaque: bool,
+        instance_buffer_pool: Arc<Mutex<InstanceBufferPool>>,
+    ) -> Result<Self> {
+        #[cfg(feature = "runtime_shaders")]
