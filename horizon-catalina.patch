+                guard.renderer_context.clone(),
+            )
+        };
+
+        Ok(Box::new(MacWindow::open(
+            handle,
+            options,
+            cursor_visible,
+            foreground_executor,
+            background_executor,
+            renderer_context,
+            self.1,
+        )?))
+    }
