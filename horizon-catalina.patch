+pub(crate) fn convert_mouse_position(position: NSPoint, window_height: Pixels) -> Point<Pixels> {
+    point(
+        px(position.x as f32),
+        // macOS screen coordinates are relative to bottom left
+        window_height - px(position.y as f32),
+    )
+}
