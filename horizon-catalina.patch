+use std::ops::Deref;
+
+use futures::channel::oneshot;
+
+use crate::{
+    AnyView, App, AppContext as _, Context, Entity, EventEmitter, FocusHandle, Focusable,
+    InteractiveElement, IntoElement, ParentElement, PromptButton, PromptLevel, Render,
+    StatefulInteractiveElement, Styled, div, opaque_grey, white,
+};
+
+use super::Window;
+
+/// The event emitted when a prompt's option is selected.
+/// The usize is the index of the selected option, from the actions
+/// passed to the prompt.
+pub struct PromptResponse(pub usize);
+
+/// A prompt that can be rendered in the window.
+pub trait Prompt: EventEmitter<PromptResponse> + Focusable {}
+
+impl<V: EventEmitter<PromptResponse> + Focusable> Prompt for V {}
+
+/// A handle to a prompt that can be used to interact with it.
+pub struct PromptHandle {
+    sender: oneshot::Sender<usize>,
+}
+
+impl PromptHandle {
+    pub(crate) fn new(sender: oneshot::Sender<usize>) -> Self {
+        Self { sender }
+    }
+
+    /// Construct a new prompt handle from a view of the appropriate types
+    pub fn with_view<V: Prompt + Render>(
+        self,
+        view: Entity<V>,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> RenderablePromptHandle {
+        let mut sender = Some(self.sender);
+        let previous_focus = window.focused(cx);
+        let window_handle = window.window_handle();
+        cx.subscribe(&view, move |_: Entity<V>, e: &PromptResponse, cx| {
+            if let Some(sender) = sender.take() {
+                sender.send(e.0).ok();
+                window_handle
+                    .update(cx, |_, window, cx| {
+                        window.prompt.take();
+                        if let Some(previous_focus) = &previous_focus {
+                            window.focus(previous_focus, cx);
+                        }
+                    })
+                    .ok();
+            }
+        })
+        .detach();
+
+        window.focus(&view.focus_handle(cx), cx);
+
+        RenderablePromptHandle {
+            view: Box::new(view),
+        }
+    }
+}
+
+/// A prompt handle capable of being rendered in a window.
+pub struct RenderablePromptHandle {
+    pub(crate) view: Box<dyn PromptViewHandle>,
+}
+
+/// Use this function in conjunction with [App::set_prompt_builder] to force
+/// GPUI to always use the fallback prompt renderer.
+pub fn fallback_prompt_renderer(
+    level: PromptLevel,
+    message: &str,
+    detail: Option<&str>,
+    actions: &[PromptButton],
+    handle: PromptHandle,
+    window: &mut Window,
+    cx: &mut App,
+) -> RenderablePromptHandle {
+    let renderer = cx.new(|cx| FallbackPromptRenderer {
+        _level: level,
+        message: message.to_string(),
+        detail: detail.map(ToString::to_string),
+        actions: actions.to_vec(),
+        focus: cx.focus_handle(),
+    });
+
+    handle.with_view(renderer, window, cx)
+}
+
+/// The default GPUI fallback for rendering prompts, when the platform doesn't support it.
+pub struct FallbackPromptRenderer {
+    _level: PromptLevel,
+    message: String,
+    detail: Option<String>,
+    actions: Vec<PromptButton>,
+    focus: FocusHandle,
+}
+
+impl Render for FallbackPromptRenderer {
+    fn render(&mut self, _: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let prompt = div()
+            .cursor_default()
+            .track_focus(&self.focus)
+            .w_72()
+            .bg(white())
+            .rounded_lg()
+            .overflow_hidden()
+            .p_3()
+            .child(
+                div()
+                    .w_full()
+                    .flex()
+                    .flex_row()
+                    .justify_around()
+                    .child(div().overflow_hidden().child(self.message.clone())),
+            )
+            .children(self.detail.clone().map(|detail| {
+                div()
+                    .w_full()
+                    .flex()
+                    .flex_row()
+                    .justify_around()
+                    .text_sm()
+                    .mb_2()
+                    .child(div().child(detail))
+            }))
+            .children(self.actions.iter().enumerate().map(|(ix, action)| {
+                div()
+                    .flex()
+                    .flex_row()
+                    .justify_around()
+                    .border_1()
+                    .border_color(opaque_grey(0.2, 0.5))
+                    .mt_1()
+                    .rounded_xs()
+                    .cursor_pointer()
+                    .text_sm()
+                    .child(action.label().clone())
+                    .id(ix)
+                    .on_click(cx.listener(move |_, _, _, cx| {
+                        cx.emit(PromptResponse(ix));
+                        cx.stop_propagation();
+                    }))
+            }));
+
+        div()
+            .size_full()
+            .child(
+                div()
+                    .size_full()
+                    .bg(opaque_grey(0.5, 0.6))
+                    .absolute()
+                    .top_0()
+                    .left_0(),
+            )
+            .child(
+                div()
+                    .size_full()
+                    .absolute()
+                    .top_0()
+                    .left_0()
+                    .flex()
+                    .flex_col()
+                    .justify_around()
+                    .child(
+                        div()
+                            .w_full()
+                            .flex()
+                            .flex_row()
+                            .justify_around()
+                            .child(prompt),
+                    ),
+            )
+    }
+}
+
+impl EventEmitter<PromptResponse> for FallbackPromptRenderer {}
+
+impl Focusable for FallbackPromptRenderer {
+    fn focus_handle(&self, _: &crate::App) -> FocusHandle {
+        self.focus.clone()
+    }
+}
+
+pub(crate) trait PromptViewHandle {
+    fn any_view(&self) -> AnyView;
+}
+
+impl<V: Prompt + Render> PromptViewHandle for Entity<V> {
+    fn any_view(&self) -> AnyView {
+        self.clone().into()
+    }
+}
+
+pub(crate) enum PromptBuilder {
+    Default,
+    Custom(
+        Box<
+            dyn Fn(
+                PromptLevel,
+                &str,
+                Option<&str>,
+                &[PromptButton],
+                PromptHandle,
+                &mut Window,
+                &mut App,
+            ) -> RenderablePromptHandle,
+        >,
+    ),
+}
+
+impl Deref for PromptBuilder {
+    type Target = dyn Fn(
+        PromptLevel,
+        &str,
+        Option<&str>,
+        &[PromptButton],
+        PromptHandle,
+        &mut Window,
+        &mut App,
+    ) -> RenderablePromptHandle;
+
+    fn deref(&self) -> &Self::Target {
+        match self {
+            Self::Default => &fallback_prompt_renderer,
+            Self::Custom(f) => f.as_ref(),
+        }
+    }
+}
diff --git a/third_party/gpui-fast-apple/src/fast/rounded_clip.rs b/third_party/gpui-fast-apple/src/fast/rounded_clip.rs
new file mode 100644
index 0000000..e477149
--- /dev/null
+++ b/third_party/gpui-fast-apple/src/fast/rounded_clip.rs
@@ -0,0 +1,289 @@
+// Modified by Longbridge for gpui-fast.
+//! Evaluate independent rounded padding edges directly in colour fragments.
+//! Nested scopes append geometry and siblings restore the enclosing stack.
+//! Only actual path batches restart the colour pass; rounded containers do
+//! not allocate textures or encode mask render passes.
+
+use std::{mem, ptr::NonNull};
+
+use anyhow::{Context as _, Result};
+use gpui::{AtlasTextureId, DevicePixels, LayerFrame, PrimitiveBatch, Scene, Size};
+use objc2::{rc::Retained, runtime::ProtocolObject};
+use objc2_core_foundation::CFRetained;
+use objc2_core_video::CVMetalTexture;
+use objc2_metal::{
+    MTLClearColor, MTLCommandBuffer, MTLCommandEncoder, MTLCommandQueue, MTLDevice,
+    MTLRenderCommandEncoder, MTLResourceOptions, MTLTexture,
+};
+
+use crate::metal_renderer::{
+    InstanceBindings, InstanceBufferWriter, MetalRenderer, new_command_encoder_for_texture,
+    write_instances,
+};
+
+const CLIP_TEXTURE_BASE: u32 = 0xF100_0000;
+
+/// Geometry is copied into Metal's command stream, never retained in a shared
+/// mutable texture. A stack remains valid when sibling scopes overlap.
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct Clip {
+    bounds: [f32; 4],
+    horizontal: [f32; 4],
+    vertical: [f32; 4],
+}
+
+fn group(scene: &Scene, texture: AtlasTextureId) -> Option<&LayerFrame> {
+    let key = texture.index.checked_sub(0xF000_0000)?;
+    if texture.index < CLIP_TEXTURE_BASE {
+        return None;
+    }
+    scene
+        .layers
+        .frames
+        .iter()
+        .find(|frame| frame.key.0 == key && frame.tile_size == 0)
+}
+
+pub(crate) fn has_groups(scene: &Scene) -> bool {
+    scene
+        .polychrome_sprites
+        .iter()
+        .any(|sprite| group(scene, sprite.tile.texture_id).is_some())
+}
+
+pub(crate) fn default_mask(encoder: &ProtocolObject<dyn MTLRenderCommandEncoder>) {
+    let count = 0u32;
+    let empty = [0f32; 12];
+    // SAFETY: Both values are live for the call, which copies their bytes into
+    // the fragment slots the injected clip parameters read.
+    unsafe {
+        encoder.setFragmentBytes_length_atIndex(NonNull::from(&count).cast(), 4, 29);
+        encoder.setFragmentBytes_length_atIndex(NonNull::from(&empty).cast(), 48, 28);
+    }
+}
+
+fn bind(
+    encoder: &ProtocolObject<dyn MTLRenderCommandEncoder>,
+    clips: &[Clip],
+    device: &ProtocolObject<dyn MTLDevice>,
+) {
+    let count = clips.len() as u32;
+    // SAFETY: `count` is live for the call, which copies its bytes.
+    unsafe {
+        encoder.setFragmentBytes_length_atIndex(NonNull::from(&count).cast(), 4, 29);
+    }
+    if !clips.is_empty() {
+        let length = mem::size_of_val(clips);
+        if length <= 4096 {
+            // SAFETY: `clips` is live for the call, which copies its `length` bytes.
+            unsafe {
+                encoder.setFragmentBytes_length_atIndex(NonNull::from(clips).cast(), length, 28);
+            }
+        } else {
+            // SAFETY: Metal copies `length` bytes of the live `clips` slice.
+            let buffer = unsafe {
+                device.newBufferWithBytes_length_options(
+                    NonNull::from(clips).cast(),
+                    length,
+                    MTLResourceOptions::StorageModeShared,
+                )
+            };
+            let Some(buffer) = buffer else {
+                log::error!("failed to allocate a {length}-byte rounded clip buffer");
+                return;
+            };
+            // SAFETY: The buffer holds `clips.len()` clips from offset zero, and
+            // the encoder retains it until the command buffer completes.
+            unsafe {
+                encoder.setFragmentBuffer_offset_atIndex(Some(&buffer), 0, 28);
+            }
+        }
+    }
+}
+
+pub(crate) fn raster_nested_tiles(renderer: &mut MetalRenderer, scene: &Scene) {
+    for sprite in &scene.polychrome_sprites {
+        if let Some(frame) = group(scene, sprite.tile.texture_id)
+            && let Some(child) = frame.content.scene()
+        {
+            crate::fast::layers::raster::rasterize_tiles(renderer, child);
+        }
+    }
+}
+
+pub(crate) fn draw(
+    renderer: &mut MetalRenderer,
+    scene: &Scene,
+    bindings: &InstanceBindings,
+    writer: &mut InstanceBufferWriter,
+    texture: &ProtocolObject<dyn MTLTexture>,
+    viewport: Size<DevicePixels>,
+    surface_textures: &mut Vec<CFRetained<CVMetalTexture>>,
+) -> Result<Retained<ProtocolObject<dyn MTLCommandBuffer>>> {
+    let queue = renderer.command_queue.clone();
+    let command_buffer = queue.commandBuffer().context("creating command buffer")?;
+    let alpha = if renderer.opaque { 1. } else { 0. };
+    let encoder = new_command_encoder_for_texture(
+        &command_buffer,
+        texture,
+        viewport,
+        Some(MTLClearColor {
+            red: 0.,
+            green: 0.,
+            blue: 0.,
+            alpha,
+        }),
+    )?;
+    encode(
+        renderer,
+        scene,
+        bindings,
+        writer,
+        texture,
+        viewport,
+        &command_buffer,
+        &mut Vec::new(),
+        surface_textures,
+        encoder,
+    )?
+    .endEncoding();
+    Ok(command_buffer)
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn draw_tile(
+    renderer: &mut MetalRenderer,
+    scene: &Scene,
+    writer: &mut InstanceBufferWriter,
+    texture: &ProtocolObject<dyn MTLTexture>,
+    viewport: Size<DevicePixels>,
+    commands: &ProtocolObject<dyn MTLCommandBuffer>,
+    background: MTLClearColor,
+    surface_textures: &mut Vec<CFRetained<CVMetalTexture>>,
+) -> Result<()> {
+    let old_texture = renderer.path_intermediate_texture.take();
+    let old_msaa = renderer.path_intermediate_msaa_texture.take();
+    let result = (|| {
+        renderer.update_path_intermediate_textures(viewport)?;
+        let bindings = write_instances(scene, writer)?;
+        let encoder =
+            new_command_encoder_for_texture(commands, texture, viewport, Some(background))?;
+        encode(
+            renderer,
+            scene,
+            &bindings,
+            writer,
+            texture,
+            viewport,
+            commands,
+            &mut Vec::new(),
+            surface_textures,
+            encoder,
+        )?
+        .endEncoding();
+        Ok(())
+    })();
+    renderer.path_intermediate_texture = old_texture;
+    renderer.path_intermediate_msaa_texture = old_msaa;
+    result
+}
+
+#[allow(clippy::too_many_arguments)]
+fn encode(
+    renderer: &mut MetalRenderer,
+    scene: &Scene,
+    bindings: &InstanceBindings,
+    writer: &mut InstanceBufferWriter,
+    texture: &ProtocolObject<dyn MTLTexture>,
+    viewport: Size<DevicePixels>,
+    commands: &ProtocolObject<dyn MTLCommandBuffer>,
+    clips: &mut Vec<Clip>,
+    surface_textures: &mut Vec<CFRetained<CVMetalTexture>>,
+    mut encoder: Retained<ProtocolObject<dyn MTLRenderCommandEncoder>>,
+) -> Result<Retained<ProtocolObject<dyn MTLRenderCommandEncoder>>> {
+    renderer.fast_layers.note_composited(scene);
+    for batch in scene.batches() {
+        bind(&encoder, clips, &renderer.device);
+        match batch {
+            PrimitiveBatch::Shadows(range) => {
+                renderer.draw_shadows(range, bindings, viewport, &encoder)
+            }
+            PrimitiveBatch::Quads(range) => {
+                renderer.draw_quads(range, bindings, viewport, &encoder)
+            }
+            PrimitiveBatch::Underlines(range) => {
+                renderer.draw_underlines(range, bindings, viewport, &encoder)
+            }
+            PrimitiveBatch::MonochromeSprites { texture_id, range } => {
+                renderer.draw_monochrome_sprites(texture_id, range, bindings, viewport, &encoder)
+            }
+            PrimitiveBatch::PolychromeSprites { texture_id, range } => {
+                if let Some(frame) = group(scene, texture_id) {
+                    let child = frame.content.scene().context("rounded clip content")?;
+                    let radii = child
+                        .layers
+                        .frames
+                        .iter()
+                        .find(|frame| frame.key.0 == u32::MAX)
+                        .context("rounded clip geometry")?
+                        .background;
+                    for index in range {
+                        let sprite = &scene.polychrome_sprites[index];
+                        let b = sprite.bounds;
+                        let r = sprite.corner_radii;
+                        clips.push(Clip {
+                            bounds: [b.origin.x.0, b.origin.y.0, b.right().0, b.bottom().0],
+                            horizontal: [
+                                r.top_left.0,
+                                r.top_right.0,
+                                r.bottom_right.0,
+                                r.bottom_left.0,
+                            ],
+                            vertical: [radii.r, radii.g, radii.b, radii.a],
+                        });
+                        let child_bindings = write_instances(child, writer)?;
+                        encoder = encode(
+                            renderer,
+                            child,
+                            &child_bindings,
+                            writer,
+                            texture,
+                            viewport,
+                            commands,
+                            clips,
+                            surface_textures,
+                            encoder,
+                        )?;
+                        clips.pop();
+                        renderer.fast_layers.note_composited(scene);
+                    }
+                } else {
+                    renderer
+                        .draw_polychrome_sprites(texture_id, range, bindings, viewport, &encoder);
+                }
+            }
+            PrimitiveBatch::Paths(range) => {
+                encoder.endEncoding();
+                let paths = &scene.paths[range];
+                let drawn =
+                    renderer.draw_paths_to_intermediate(paths, writer, viewport, commands)?;
+                encoder = new_command_encoder_for_texture(commands, texture, viewport, None)?;
+                bind(&encoder, clips, &renderer.device);
+                if drawn {
+                    renderer.draw_paths_from_intermediate(paths, writer, viewport, &encoder)?;
+                }
+            }
+            PrimitiveBatch::Surfaces(range) => renderer.draw_surfaces(
+                &scene.surfaces[range.clone()],
+                range.start,
+                bindings,
+                viewport,
+                &encoder,
+                surface_textures,
+            )?,
+            PrimitiveBatch::SubpixelSprites { .. } => unreachable!("Metal uses grayscale glyphs"),
+        }
+    }
+    Ok(encoder)
+}
diff --git a/third_party/gpui-fast-apple/src/fast/rounded_clip_shader.rs b/third_party/gpui-fast-apple/src/fast/rounded_clip_shader.rs
new file mode 100644
index 0000000..d748ec0
--- /dev/null
+++ b/third_party/gpui-fast-apple/src/fast/rounded_clip_shader.rs
@@ -0,0 +1,101 @@
+// Modified by Longbridge for gpui-fast.
+//! Build-time injection keeps the upstream Metal shader source unchanged.
+//! Each colour-producing fragment evaluates its immutable clip stack. Path
+//! rasterization itself is unmasked; its premultiplied result is masked when
+//! the path sprite is composited, avoiding applying coverage twice.
+
+pub fn source(source: &str) -> String {
+    let mut source = source.to_owned();
+    for name in [
+        "quad_fragment",
+        "shadow_fragment",
+        "underline_fragment",
+        "monochrome_sprite_fragment",
+        "polychrome_sprite_fragment",
+        "path_sprite_fragment",
+        "surface_fragment",
+    ] {
+        let start = source
+            .find(&format!("fragment float4 {name}("))
+            .expect("upstream fragment entry point");
+        let body_start = start + source[start..].find('{').unwrap();
+        let signature_end = source[..body_start].rfind(')').unwrap();
+        let mut depth = 1;
+        let mut body_end = body_start + 1;
+        for (offset, ch) in source[body_start + 1..].char_indices() {
+            match ch {
+                '{' => depth += 1,
+                '}' => depth -= 1,
+                _ => {}
+            }
+            if depth == 0 {
+                body_end = body_start + 1 + offset;
+                break;
+            }
+        }
+        let body = &source[body_start + 1..body_end];
+        let premultiplied = name == "path_sprite_fragment";
+        let body = mask_returns(body, premultiplied);
+        source.replace_range(body_start + 1..body_end, &body);
+        source.insert_str(signature_end, ", constant FastRoundedClip *fast_clip_shapes [[buffer(28)]], constant uint &fast_clip_enabled [[buffer(29)]]");
+    }
+    let helper = r#"
+struct FastRoundedClip {
+  float4 bounds;
+  float4 horizontal;
+  float4 vertical;
+};
+float fast_rounded_clip_coverage(float2 position, constant FastRoundedClip &shape) {
+  float2 extent = shape.bounds.zw - shape.bounds.xy;
+  if (extent.x <= 0 || extent.y <= 0) return 0;
+  float2 local = position - shape.bounds.xy;
+  float distance = max(max(-local.x, -local.y), max(local.x - extent.x, local.y - extent.y));
+  for (uint corner = 0; corner < 4; ++corner) {
+    float2 radius = float2(shape.horizontal[corner], shape.vertical[corner]);
+    if (radius.x <= 0 || radius.y <= 0) continue;
+    bool right = corner == 1 || corner == 2;
+    bool bottom = corner >= 2;
+    float2 inward = float2(right ? extent.x - local.x : local.x, bottom ? extent.y - local.y : local.y);
+    if (inward.x < radius.x && inward.y < radius.y) {
+      float2 q = (inward - radius) / radius;
+      float length_q = length(q);
+      float gradient = length(q / radius) / max(length_q, 0.000001f);
+      distance = max(distance, (length_q - 1) / max(gradient, 0.000001f));
+    }
+  }
+  return clamp(0.5f - distance, 0.0f, 1.0f);
+}
+float4 fast_rounded_clip_color(float4 color, float2 position, constant FastRoundedClip *shapes, uint count, bool premultiplied) {
+  float coverage = 1;
+  for (uint index = 0; index < count; ++index) {
+    coverage = min(coverage, fast_rounded_clip_coverage(position, shapes[index]));
+  }
+  if (premultiplied) color.rgb *= coverage;
+  color.a *= coverage;
+  return color;
+}
+"#;
+    let offset = source.find("using namespace metal;").unwrap() + "using namespace metal;".len();
+    source.insert_str(offset, helper);
+    source
+}
+
+pub fn stage(input: impl AsRef<std::path::Path>, output: impl AsRef<std::path::Path>) {
+    std::fs::write(output, source(&std::fs::read_to_string(input).unwrap())).unwrap();
+}
+
+fn mask_returns(body: &str, premultiplied: bool) -> String {
+    let mut result = String::new();
+    let mut remaining = body;
+    while let Some(start) = remaining.find("return ") {
+        let end = start
+            + remaining[start..]
+                .find(';')
+                .expect("fragment return semicolon");
+        result.push_str(&remaining[..start]);
+        result.push_str(&format!("return fast_rounded_clip_color({}, input.position.xy, fast_clip_shapes, fast_clip_enabled, {premultiplied});", &remaining[start + 7..end]));
+        remaining = &remaining[end + 1..];
+    }
+    result.push_str(remaining);
+    result
+}
diff --git a/third_party/gpui-fast-apple/src/fast/text_system.rs b/third_party/gpui-fast-apple/src/fast/text_system.rs
new file mode 100644
index 0000000..816561d
--- /dev/null
+++ b/third_party/gpui-fast-apple/src/fast/text_system.rs
@@ -0,0 +1,72 @@
+// Modified by Longbridge for gpui-fast.
+//! Native fonts made once per size and kept, so CoreText's shaping caches survive from line to line.
+
+use collections::HashMap;
+use core_text::font::CTFont;
+use font_kit::font::Font as FontKitFont;
+use gpui::{FontId, Pixels};
+
+/// Each font at each size a line has been laid out at. CoreText keeps the
+/// caches it builds for shaping — the advances and glyphs of ASCII among
+/// them — on the font object, so a font made afresh for every line built
+/// them again for every line.
+#[derive(Default)]
+pub(crate) struct SizedFonts(HashMap<(FontId, u32), CTFont>);
+
+impl SizedFonts {
+    /// The native font for `font`, whose id is `font_id`, at `font_size`, made
+    /// once and kept.
+    pub(crate) fn get(&mut self, font_id: FontId, font: &FontKitFont, font_size: Pixels) -> CTFont {
+        // Sizes can animate, and every size a font is drawn at would otherwise
+        // be kept for good.
+        const MAX_SIZED_FONTS: usize = 1024;
+        let key = (font_id, f32::from(font_size).to_bits());
+        if let Some(font) = self.0.get(&key) {
+            return font.clone();
+        }
+        if self.0.len() >= MAX_SIZED_FONTS {
+            self.0.clear();
+        }
+        let font = font
+            .native_font()
+            .clone_with_font_size(f32::from(font_size).into());
+        self.0.insert(key, font.clone());
+        font
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use crate::AppleTextSystem;
+    use gpui::{FontRun, PlatformTextSystem, font, px};
+
+    /// Fonts are made once per size and kept, so a line laid out with a kept
+    /// font has to come out exactly as it did with a new one: the same glyphs
+    /// in the same places, however many runs split it into sizes a hair
+    /// apart, and never mixed up with the same font at another size.
+    #[test]
+    fn lines_laid_out_with_kept_fonts_match_the_first_layout() {
+        let fonts = AppleTextSystem::new();
+        let font_id = fonts.font_id(&font("Helvetica")).unwrap();
+        let line = "AVAWAY fi ffi 12.5 office";
+        // Runs alternate between two sizes a hair apart, to keep ligatures
+        // from joining across them.
+        let runs = [5, 3, 4, 5, 8].map(|len| FontRun { font_id, len });
+        let shape = |size| {
+            let layout = fonts.layout_line(line, px(size), &runs);
+            let glyphs = layout
+                .runs
+                .iter()
+                .flat_map(|run| run.glyphs.iter().map(|glyph| (glyph.id, glyph.position)))
+                .collect::<Vec<_>>();
+            (layout.width, glyphs)
+        };
+
+        let first = shape(16.);
+        assert_eq!(shape(16.), first, "a kept font shapes differently");
+        let larger = shape(24.);
+        assert_ne!(larger.0, first.0, "another size has to be another font");
+        assert_eq!(shape(16.), first, "a size laid out again after another");
+        assert_eq!(shape(24.), larger);
+    }
+}
diff --git a/third_party/gpui-fast-apple/src/gpui_apple.rs b/third_party/gpui-fast-apple/src/gpui_apple.rs
new file mode 100644
index 0000000..9edfa63
--- /dev/null
+++ b/third_party/gpui-fast-apple/src/gpui_apple.rs
@@ -0,0 +1,49 @@
+// Modified by Longbridge for gpui-fast.
+#![cfg(any(target_os = "macos", target_os = "ios"))]
+//! Shared Apple rendering, task dispatch, and system services for GPUI.
+//!
+//! This crate renders GPUI scenes directly with Metal on Apple platforms. It
+//! owns GPU resources, text rendering, Keychain access, and thermal notifications
+//! while leaving application lifecycle, windowing, and input to each platform backend.
+
+mod dispatcher;
+pub mod display_link;
+mod fast;
+pub mod keychain;
+mod metal_atlas;
+pub mod metal_renderer;
+pub mod process_info;
+
+#[cfg(feature = "font-kit")]
+mod open_type;
+#[cfg(feature = "font-kit")]
+mod text_system;
+
+use objc2::MainThreadMarker;
+
+pub use dispatcher::{AppleActivity, AppleDispatcher};
+#[cfg(feature = "font-kit")]
+pub use text_system::AppleTextSystem;
+
+#[inline]
+pub fn main_thread_marker() -> Option<MainThreadMarker> {
+    thread_local! {
+        static MAIN_THREAD_MARKER: Option<MainThreadMarker> = MainThreadMarker::new();
+    }
+    MAIN_THREAD_MARKER.with(|marker| *marker)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::main_thread_marker;
+
+    #[test]
+    fn main_thread_marker_rejects_background_threads() {
+        std::thread::spawn(|| {
+            assert_eq!(main_thread_marker(), None);
+            assert_eq!(main_thread_marker(), None);
+        })
+        .join()
+        .expect("background thread panicked");
+    }
+}
diff --git a/third_party/gpui-fast-apple/src/keychain.rs b/third_party/gpui-fast-apple/src/keychain.rs
new file mode 100644
index 0000000..a40eafc
--- /dev/null
+++ b/third_party/gpui-fast-apple/src/keychain.rs
@@ -0,0 +1,283 @@
+use objc2_core_foundation::{CFData, CFDictionary, CFRetained, CFString, CFType, kCFBooleanTrue};
+use objc2_security::{
+    SecItemAdd, SecItemCopyMatching, SecItemDelete, SecItemUpdate, errSecDuplicateItem,
+    errSecItemNotFound, errSecSuccess, errSecUserCanceled, kSecAttrAccount, kSecAttrServer,
+    kSecClass, kSecClassInternetPassword, kSecReturnAttributes, kSecReturnData, kSecValueData,
+};
+use std::ptr;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum KeychainOperation {
+    Read,
+    Update,
+    Create,
+    Delete,
+}
+
+#[derive(Debug, thiserror::Error, PartialEq, Eq)]
+pub enum KeychainError {
+    #[error("Keychain access was cancelled.")]
+    UserCanceled { operation: KeychainOperation },
+    #[error("keychain {operation:?} failed with OSStatus {status}")]
+    Security {
+        operation: KeychainOperation,
+        status: i32,
+    },
+    #[error("invalid keychain response: {0}")]
+    InvalidResponse(&'static str),
+}
+
+pub fn write_credentials(
+    server: &str,
+    account: &str,
+    password: &[u8],
+) -> Result<(), KeychainError> {
+    let server = CFString::from_str(server);
+    let account = CFString::from_str(account);
+    let password = CFData::from_bytes(password);
+    // SAFETY: Reading immutable constants exported by the Security framework.
+    let (class_key, server_key, account_key, data_key, internet_password) = unsafe {
+        (
+            kSecClass,
+            kSecAttrServer,
+            kSecAttrAccount,
+            kSecValueData,
+            kSecClassInternetPassword,
+        )
+    };
+    let query = CFDictionary::<CFString, CFType>::from_slices(
+        &[class_key, server_key],
+        &[internet_password, &server],
+    );
+    let attributes = CFDictionary::<CFString, CFType>::from_slices(
+        &[account_key, data_key],
+        &[&account, &password],
+    );
+    let mut operation = KeychainOperation::Update;
+    // SAFETY: Both dictionaries map Security attribute keys to CF values.
+    let mut status = unsafe { SecItemUpdate(query.as_opaque(), attributes.as_opaque()) };
+    if status == errSecItemNotFound {
+        operation = KeychainOperation::Create;
+        status = add_credentials(&server, &account, &password);
+    }
+    check_status(operation, status)
+}
+
+/// Atomically adds a Keychain item unless one with this server and account exists.
+///
+/// Returns `false` if the item exists, leaving its secret unchanged. Items for the
+/// same server under a different account are not conflicts.
+pub fn write_credentials_if_not_exists(
+    server: &str,
+    account: &str,
+    password: &[u8],
+) -> Result<bool, KeychainError> {
+    let server = CFString::from_str(server);
+    let account = CFString::from_str(account);
+    let password = CFData::from_bytes(password);
+    create_status(add_credentials(&server, &account, &password))
+}
+
+fn add_credentials(server: &CFString, account: &CFString, password: &CFData) -> i32 {
+    // SAFETY: Reading immutable constants exported by the Security framework.
+    let (class_key, server_key, account_key, data_key, internet_password) = unsafe {
+        (
+            kSecClass,
+            kSecAttrServer,
+            kSecAttrAccount,
+            kSecValueData,
+            kSecClassInternetPassword,
+        )
+    };
+    let attributes = CFDictionary::<CFString, CFType>::from_slices(
+        &[class_key, server_key, account_key, data_key],
+        &[internet_password, server, account, password],
+    );
+    // SAFETY: The dictionary maps Security attribute keys to CF values, and a
+    // null result pointer asks Security not to return the new item.
+    unsafe { SecItemAdd(attributes.as_opaque(), ptr::null_mut()) }
+}
+
+/// Reads credentials by server, returning `None` when no item exists.
+pub fn read_credentials(server: &str) -> Result<Option<(String, Vec<u8>)>, KeychainError> {
+    let server = CFString::from_str(server);
+    // SAFETY: Reading immutable constants exported by Core Foundation and Security.
+    let (
+        true_value,
+        class_key,
+        server_key,
+        return_attributes_key,
+        return_data_key,
+        internet_password,
+    ) = unsafe {
+        (
+            kCFBooleanTrue,
+            kSecClass,
+            kSecAttrServer,
+            kSecReturnAttributes,
+            kSecReturnData,
+            kSecClassInternetPassword,
+        )
+    };
+    let true_value = true_value.ok_or(KeychainError::InvalidResponse(
+        "Core Foundation true value unavailable",
+    ))?;
+    let query = CFDictionary::<CFString, CFType>::from_slices(
+        &[
+            class_key,
+            server_key,
+            return_attributes_key,
+            return_data_key,
+        ],
+        &[internet_password, &server, true_value, true_value],
+    );
+    let mut result = ptr::null();
+    // SAFETY: The query maps Security attribute keys to CF values, and `result`
+    // is a valid out-pointer.
+    let status = unsafe { SecItemCopyMatching(query.as_opaque(), &mut result) };
+    if !read_status(status)? {
+        return Ok(None);
+    }
+    let result = ptr::NonNull::new(result.cast_mut())
+        .ok_or(KeychainError::InvalidResponse("keychain returned no item"))?;
+    // SAFETY: SecItemCopyMatching follows the Create rule, so we own this reference.
+    let result = unsafe { CFRetained::from_raw(result) }
+        .downcast::<CFDictionary>()
+        .map_err(|_| KeychainError::InvalidResponse("keychain item was not a dictionary"))?;
+    // SAFETY: Security returns CFType keys and values; each value is downcast below.
+    let result = unsafe { result.cast_unchecked::<CFType, CFType>() };
+    // SAFETY: Reading immutable constants exported by the Security framework.
+    let (account_key, data_key) = unsafe { (kSecAttrAccount, kSecValueData) };
+    let account = result
+        .get(account_key)
+        .ok_or(KeychainError::InvalidResponse(
+            "account was missing from keychain item",
+        ))?
+        .downcast::<CFString>()
+        .map_err(|_| KeychainError::InvalidResponse("account was not a string"))?;
+    let password = result
+        .get(data_key)
+        .ok_or(KeychainError::InvalidResponse(
+            "password was missing from keychain item",
+        ))?
+        .downcast::<CFData>()
+        .map_err(|_| KeychainError::InvalidResponse("password was not data"))?;
+    Ok(Some((account.to_string(), password.to_vec())))
+}
+
+pub fn delete_credentials(server: &str) -> Result<(), KeychainError> {
+    let server = CFString::from_str(server);
+    // SAFETY: Reading immutable constants exported by the Security framework.
+    let (class_key, server_key, internet_password) =
+        unsafe { (kSecClass, kSecAttrServer, kSecClassInternetPassword) };
+    let query = CFDictionary::<CFString, CFType>::from_slices(
+        &[class_key, server_key],
+        &[internet_password, &server],
+    );
+    // SAFETY: The query maps Security attribute keys to CF values.
+    let status = unsafe { SecItemDelete(query.as_opaque()) };
+    check_status(KeychainOperation::Delete, status)
+}
+
+fn read_status(status: i32) -> Result<bool, KeychainError> {
+    if status == errSecItemNotFound {
+        Ok(false)
+    } else {
+        check_status(KeychainOperation::Read, status)?;
+        Ok(true)
+    }
+}
+
+fn create_status(status: i32) -> Result<bool, KeychainError> {
+    if status == errSecDuplicateItem {
+        Ok(false)
+    } else {
+        check_status(KeychainOperation::Create, status)?;
+        Ok(true)
+    }
+}
+
+fn check_status(operation: KeychainOperation, status: i32) -> Result<(), KeychainError> {
+    if status == errSecSuccess {
+        Ok(())
+    } else if status == errSecUserCanceled {
+        Err(KeychainError::UserCanceled { operation })
+    } else {
+        Err(KeychainError::Security { operation, status })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use objc2_security::errSecAuthFailed;
+
+    #[test]
+    fn read_distinguishes_absence_and_cancellation_from_errors() {
+        assert!(read_status(errSecSuccess).unwrap());
+        assert!(!read_status(errSecItemNotFound).unwrap());
+        assert_eq!(
+            read_status(errSecUserCanceled),
+            Err(KeychainError::UserCanceled {
+                operation: KeychainOperation::Read,
+            })
+        );
+        assert_eq!(
+            read_status(errSecAuthFailed),
+            Err(KeychainError::Security {
+                operation: KeychainOperation::Read,
+                status: errSecAuthFailed,
+            })
+        );
+    }
+
+    #[test]
+    fn platform_error_keeps_native_operation_and_status() {
+        let error: anyhow::Error = check_status(KeychainOperation::Update, errSecAuthFailed)
+            .unwrap_err()
+            .into();
+        assert_eq!(
+            error.downcast_ref::<KeychainError>(),
+            Some(&KeychainError::Security {
+                operation: KeychainOperation::Update,
+                status: errSecAuthFailed,
+            })
+        );
+    }
+
+    #[test]
+    fn delete_preserves_macos_missing_item_error() {
+        assert_eq!(
+            check_status(KeychainOperation::Delete, errSecSuccess),
+            Ok(())
+        );
+        for status in [errSecItemNotFound, errSecAuthFailed] {
+            assert_eq!(
+                check_status(KeychainOperation::Delete, status),
+                Err(KeychainError::Security {
+                    operation: KeychainOperation::Delete,
+                    status,
+                })
+            );
+        }
+        assert_eq!(
+            check_status(KeychainOperation::Delete, errSecUserCanceled),
+            Err(KeychainError::UserCanceled {
+                operation: KeychainOperation::Delete,
+            })
+        );
+    }
+
+    #[test]
+    fn create_reports_existing_items_without_error() {
+        assert_eq!(create_status(errSecSuccess), Ok(true));
+        assert_eq!(create_status(errSecDuplicateItem), Ok(false));
+        assert_eq!(
+            create_status(errSecItemNotFound),
+            Err(KeychainError::Security {
+                operation: KeychainOperation::Create,
+                status: errSecItemNotFound,
+            })
+        );
+    }
+}
diff --git a/third_party/gpui-fast-apple/src/metal_atlas.rs b/third_party/gpui-fast-apple/src/metal_atlas.rs
new file mode 100644
index 0000000..8bb14d6
--- /dev/null
+++ b/third_party/gpui-fast-apple/src/metal_atlas.rs
@@ -0,0 +1,572 @@
+use anyhow::{Context as _, Result, ensure};
+use etagere::BucketedAtlasAllocator;
+use gpui::{
+    AtlasBackend, AtlasKey, AtlasState, AtlasTextureId, AtlasTextureKind, AtlasTextureList,
+    AtlasTile, Bounds, DevicePixels, PlatformAtlas, Point, Size,
+};
+use objc2::{rc::Retained, runtime::ProtocolObject};
+use objc2_metal::{
+    MTLDevice, MTLOrigin, MTLPixelFormat, MTLRegion, MTLSize, MTLStorageMode, MTLTexture,
+    MTLTextureDescriptor, MTLTextureUsage,
+};
+use parking_lot::Mutex;
+use std::{borrow::Cow, ptr::NonNull};
+
+pub struct MetalAtlas(Mutex<AtlasState<MetalAtlasTextures>>);
+
+impl MetalAtlas {
+    pub(crate) fn new(
+        device: Retained<ProtocolObject<dyn MTLDevice>>,
+        supports_shared_storage: bool,
+    ) -> Self {
+        MetalAtlas(Mutex::new(AtlasState::new(MetalAtlasTextures {
+            device,
+            supports_shared_storage,
+            monochrome_textures: AtlasTextureList::default(),
+            polychrome_textures: AtlasTextureList::default(),
+        })))
+    }
+
+    /// Returns the GPU texture backing `id`, or `None` once every tile in it
+    /// has been removed. A scene can still reference such a texture when a
+    /// cached view replays a paint from before the image was dropped, so
+    /// callers must skip those sprites rather than assume the texture exists.
+    pub(crate) fn metal_texture(
+        &self,
+        id: AtlasTextureId,
+    ) -> Option<Retained<ProtocolObject<dyn MTLTexture>>> {
+        Some(self.0.lock().backend.texture(id)?.metal_texture.clone())
+    }
+}
+
+struct MetalAtlasTextures {
+    device: Retained<ProtocolObject<dyn MTLDevice>>,
+    supports_shared_storage: bool,
+    monochrome_textures: AtlasTextureList<MetalAtlasTexture>,
+    polychrome_textures: AtlasTextureList<MetalAtlasTexture>,
+}
+
+impl PlatformAtlas for MetalAtlas {
+    fn get_or_insert_with<'a>(
+        &self,
+        key: AtlasKey,
+        build: &mut dyn FnMut() -> Result<Option<(Size<DevicePixels>, Cow<'a, [u8]>)>>,
+    ) -> Result<Option<AtlasTile>> {
+        self.0.lock().get_or_insert_with(key, build)
+    }
+
+    fn remove(&self, key: &AtlasKey) {
+        self.0.lock().remove(key);
+    }
+}
+
+impl AtlasBackend for MetalAtlasTextures {
+    fn insert(
+        &mut self,
+        kind: AtlasTextureKind,
+        size: Size<DevicePixels>,
+        bytes: &[u8],
+    ) -> Result<AtlasTile> {
+        let upload = AtlasUpload::new(kind, size, bytes)?;
+        let tile = self.allocate(size, kind)?;
+        let texture = self
+            .texture(tile.texture_id)
+            .context("looking up allocated atlas texture")?;
+        texture.upload(tile.bounds.origin, &upload)?;
+        Ok(tile)
+    }
+
+    fn remove(&mut self, tile: AtlasTile) {
+        let id = tile.texture_id;
+
+        let textures = match id.kind {
+            AtlasTextureKind::Monochrome => &mut self.monochrome_textures,
+            AtlasTextureKind::Polychrome => &mut self.polychrome_textures,
+            AtlasTextureKind::Subpixel => unreachable!(),
+        };
+
+        let Some(texture_slot) = textures
+            .textures
+            .iter_mut()
+            .find(|texture| texture.as_ref().is_some_and(|v| v.id == id))
+        else {
+            return;
+        };
+
+        if let Some(mut texture) = texture_slot.take() {
+            texture.allocator.deallocate(tile.tile_id.into());
+            texture.decrement_ref_count();
+            if texture.is_unreferenced() {
+                textures.free_list.push(id.index as usize);
+            } else {
+                *texture_slot = Some(texture);
+            }
+        }
+    }
+}
+
+impl MetalAtlasTextures {
+    fn allocate(
+        &mut self,
+        size: Size<DevicePixels>,
+        texture_kind: AtlasTextureKind,
+    ) -> Result<AtlasTile> {
+        {
+            let textures = match texture_kind {
+                AtlasTextureKind::Monochrome => &mut self.monochrome_textures,
+                AtlasTextureKind::Polychrome => &mut self.polychrome_textures,
+                AtlasTextureKind::Subpixel => unreachable!(),
+            };
+
+            if let Some(tile) = textures
+                .iter_mut()
+                .rev()
+                .find_map(|texture| texture.allocate(size))
+            {
+                return Ok(tile);
+            }
+        }
+
+        let texture = self.push_texture(size, texture_kind)?;
+        texture.allocate(size).context("allocating atlas tile")
+    }
+
+    fn push_texture(
+        &mut self,
+        min_size: Size<DevicePixels>,
+        kind: AtlasTextureKind,
+    ) -> Result<&mut MetalAtlasTexture> {
+        const DEFAULT_ATLAS_SIZE: Size<DevicePixels> = Size {
+            width: DevicePixels(1024),
+            height: DevicePixels(1024),
+        };
+        // Max texture size on all modern Apple GPUs. Anything bigger than that crashes in validateWithDevice.
+        const MAX_ATLAS_SIZE: Size<DevicePixels> = Size {
+            width: DevicePixels(16384),
+            height: DevicePixels(16384),
+        };
+        let size = min_size.min(&MAX_ATLAS_SIZE).max(&DEFAULT_ATLAS_SIZE);
+        let texture_descriptor = MTLTextureDescriptor::new();
+        // SAFETY: Both dimensions are clamped to the existing 1024..=16384 atlas size limits.
+        unsafe {
+            texture_descriptor.setWidth(size.width.0 as usize);
+            texture_descriptor.setHeight(size.height.0 as usize);
+        }
+        let pixel_format;
+        let usage;
+        match kind {
+            AtlasTextureKind::Monochrome => {
+                pixel_format = MTLPixelFormat::A8Unorm;
+                usage = MTLTextureUsage::ShaderRead;
+            }
+            AtlasTextureKind::Polychrome => {
+                pixel_format = MTLPixelFormat::BGRA8Unorm;
+                usage = MTLTextureUsage::ShaderRead;
+            }
+            AtlasTextureKind::Subpixel => unreachable!(),
+        }
+        texture_descriptor.setPixelFormat(pixel_format);
+        texture_descriptor.setUsage(usage);
+        // Shared memory mode can be used only on Apple GPU families
+        // https://developer.apple.com/documentation/metal/mtlresourceoptions/storagemodeshared
+        texture_descriptor.setStorageMode(if self.supports_shared_storage {
+            MTLStorageMode::Shared
+        } else {
+            MTLStorageMode::Managed
+        });
+        let metal_texture = self
+            .device
+            .newTextureWithDescriptor(&texture_descriptor)
+            .context("allocating atlas texture")?;
+
+        let texture_list = match kind {
+            AtlasTextureKind::Monochrome => &mut self.monochrome_textures,
+            AtlasTextureKind::Polychrome => &mut self.polychrome_textures,
+            AtlasTextureKind::Subpixel => unreachable!(),
+        };
+
+        let index = texture_list.free_list.pop().unwrap_or_else(|| {
+            let index = texture_list.textures.len();
+            texture_list.textures.push(None);
+            index
+        });
+
+        let atlas_texture = MetalAtlasTexture {
+            id: AtlasTextureId {
+                index: index as u32,
+                kind,
+            },
+            allocator: etagere::BucketedAtlasAllocator::new(size_to_etagere(size)),
+            metal_texture,
+            live_atlas_keys: 0,
+        };
+
+        Ok(texture_list.textures[index].insert(atlas_texture))
+    }
+
+    fn texture(&self, id: AtlasTextureId) -> Option<&MetalAtlasTexture> {
+        let textures = match id.kind {
+            AtlasTextureKind::Monochrome => &self.monochrome_textures,
+            AtlasTextureKind::Polychrome => &self.polychrome_textures,
+            AtlasTextureKind::Subpixel => unreachable!(),
+        };
+        textures.textures.get(id.index as usize)?.as_ref()
+    }
+}
+
+struct MetalAtlasTexture {
+    id: AtlasTextureId,
+    allocator: BucketedAtlasAllocator,
+    metal_texture: Retained<ProtocolObject<dyn MTLTexture>>,
+    live_atlas_keys: u32,
+}
+
+impl MetalAtlasTexture {
+    fn allocate(&mut self, size: Size<DevicePixels>) -> Option<AtlasTile> {
+        let allocation = self.allocator.allocate(size_to_etagere(size))?;
+        let tile = AtlasTile {
+            texture_id: self.id,
+            tile_id: allocation.id.into(),
+            bounds: Bounds {
+                origin: point_from_etagere(allocation.rectangle.min),
+                size,
+            },
+            padding: 0,
+        };
+        self.live_atlas_keys += 1;
+        Some(tile)
+    }
+
+    fn upload(&self, origin: Point<DevicePixels>, upload: &AtlasUpload<'_>) -> Result<()> {
+        ensure!(
+            self.id.kind == upload.kind,
+            "atlas upload kind does not match texture"
+        );
+        ensure!(
+            origin.x.0 >= 0
+                && origin.y.0 >= 0
+                && (origin.x.0 as usize)
+                    .checked_add(upload.size.width.0 as usize)
+                    .is_some_and(|end| end <= self.metal_texture.width())
+                && (origin.y.0 as usize)
+                    .checked_add(upload.size.height.0 as usize)
+                    .is_some_and(|end| end <= self.metal_texture.height()),
+            "atlas upload is outside texture bounds"
+        );
+        let region = MTLRegion {
+            origin: MTLOrigin {
+                x: origin.x.0 as usize,
+                y: origin.y.0 as usize,
+                z: 0,
+            },
+            size: MTLSize {
+                width: upload.size.width.0 as usize,
+                height: upload.size.height.0 as usize,
+                depth: 1,
+            },
+        };
+        // SAFETY: Validated bytes cover every row of the checked region in this CPU-accessible texture.
+        // The borrowed bytes remain live for the copy; GPU ordering is a separate caller requirement.
+        unsafe {
+            self.metal_texture
+                .replaceRegion_mipmapLevel_withBytes_bytesPerRow(
+                    region,
+                    0,
+                    NonNull::from(upload.bytes).cast(),
+                    upload.bytes_per_row,
+                );
+        }
+        Ok(())
+    }
+
+    fn decrement_ref_count(&mut self) {
+        self.live_atlas_keys -= 1;
+    }
+
+    fn is_unreferenced(&mut self) -> bool {
+        self.live_atlas_keys == 0
+    }
+}
+
+struct AtlasUpload<'a> {
+    kind: AtlasTextureKind,
+    size: Size<DevicePixels>,
+    bytes: &'a [u8],
+    bytes_per_row: usize,
+}
+
+impl<'a> AtlasUpload<'a> {
+    fn new(kind: AtlasTextureKind, size: Size<DevicePixels>, bytes: &'a [u8]) -> Result<Self> {
+        ensure!(
+            size.width.0 > 0 && size.height.0 > 0,
+            "atlas dimensions must be positive"
+        );
+        let bytes_per_pixel = match kind {
+            AtlasTextureKind::Monochrome => 1,
+            AtlasTextureKind::Polychrome => 4,
+            AtlasTextureKind::Subpixel => unreachable!(),
+        };
+        let bytes_per_row = (size.width.0 as usize)
+            .checked_mul(bytes_per_pixel)
+            .context("calculating atlas row byte count")?;
+        let byte_count = bytes_per_row
+            .checked_mul(size.height.0 as usize)
+            .context("calculating atlas byte count")?;
+        ensure!(
+            bytes.len() >= byte_count,
+            "atlas upload byte length is {}, expected at least {byte_count}",
+            bytes.len()
+        );
+        Ok(Self {
+            kind,
+            size,
+            bytes,
+            bytes_per_row,
+        })
+    }
+}
+
+fn size_to_etagere(size: Size<DevicePixels>) -> etagere::Size {
+    etagere::Size::new(size.width.into(), size.height.into())
+}
+
+fn point_from_etagere(value: etagere::Point) -> Point<DevicePixels> {
+    Point {
+        x: DevicePixels::from(value.x),
+        y: DevicePixels::from(value.y),
+    }
+}
