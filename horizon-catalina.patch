diff --git a/tools/catalina/build.sh b/tools/catalina/build.sh
new file mode 100755
index 0000000..3ddfe16
--- /dev/null
+++ b/tools/catalina/build.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+# Build Horizon's game programs (and, with --launcher, the launcher) for macOS 10.15 Catalina.
+# Run on the Mac. See docs/macos-catalina.md.
+set -euo pipefail
+cd "$(dirname "$0")/../.."
+
+[[ "$(uname -s)" == Darwin ]] || { echo "run this on the Mac"; exit 1; }
+ver=$(sw_vers -productVersion); echo "macOS $ver"
+# Every C dependency (mimalloc, hidapi, ring...) and rustc itself then target 10.15, not the SDK's version.
+export MACOSX_DEPLOYMENT_TARGET=10.15
+
+command -v cargo >/dev/null || { echo "cargo not found: install Rust 1.95 or newer from rustup.rs"; exit 1; }
+echo "$(rustc --version)"
+xcode-select -p >/dev/null 2>&1 || { echo "install Xcode 12.4 (or its Command Line Tools): xcode-select --install"; exit 1; }
+if ! jdk=$(/usr/libexec/java_home -v 25 2>/dev/null); then
+  echo "warning: no JDK 25 found (horizon-prepare needs one). Install Temurin 25.0.2: brew install --cask temurin@25"
+  echo "         Newer Temurin 25 builds list macOS 11 as their minimum; keep 25.0.2 on Catalina."
+else echo "JDK 25: $jdk"; fi
+
+cargo build --release --locked -p horizon-client -p horizon-client-lib --bin horizon-client --bin horizon-ctl \
+  -p horizon-prepare --bin horizon-prepare
+
+if [[ "${1:-}" == "--launcher" ]]; then
+  # GPUI's shaders are compiled by `xcrun metal`, which only the full Xcode has (not the Command Line Tools).
+  xcrun -sdk macosx -f metal >/dev/null 2>&1 || { echo "the launcher needs the full Xcode (xcrun metal)"; exit 1; }
+  export HORIZON_METAL_MIN_MACOS=10.15
+  (cd launcher && cargo build --release)
+fi
+echo "built. next: tools/catalina/check.sh"
diff --git a/tools/catalina/check.sh b/tools/catalina/check.sh
new file mode 100755
index 0000000..f73c39c
--- /dev/null
+++ b/tools/catalina/check.sh
@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+# Is this build loadable on macOS 10.15, and does the game start? Run on the Mac, after build.sh.
+# Usage: tools/catalina/check.sh [bin-dir]   (default target/release)
+set -uo pipefail
+cd "$(dirname "$0")/../.."
+bin=${1:-target/release}; fail=0
+# Frameworks that do not exist on macOS 10.15: a hard link to any of them stops dyld before main.
+absent='UniformTypeIdentifiers|ScreenCaptureKit|Symbols\.framework|SwiftUI|Combine|MetricKit|CoreHaptics'
+for p in "$bin/horizon-client" "$bin/horizon-ctl" "$bin/horizon-prepare" launcher/target/release/horizon-launcher; do
+  [[ -f $p ]] || continue
+  minos=$(otool -l "$p" | awk '/LC_BUILD_VERSION/{f=1} f&&/minos/{print $2; exit} /LC_VERSION_MIN_MACOSX/{g=1} g&&/version/{print $2; exit}')
+  echo "== $p: minimum macOS $minos"
+  if otool -L "$p" | grep -E "$absent"; then echo "   FAIL: links a framework macOS 10.15 does not have"; fail=1; fi
+  # Prints nothing on success; dyld resolves every non-lazy symbol at load, so --help running proves them.
+  if [[ $p != *launcher ]]; then "$p" --help >/dev/null 2>&1 || { echo "   FAIL: $p --help did not run"; fail=1; }; fi
+done
+echo
+echo "GPU: $(system_profiler SPDisplaysDataType 2>/dev/null | grep -E 'Chipset Model|Metal' | tr -s ' ' | tr '\n' ';')"
+echo "Smoke test (needs the resources horizon-prepare builds into .local/horizon-client/26.3):"
+echo "  home=\$(mktemp -d); cd \"\$home\" && HORIZON_HOME=\"\$home\" HORIZON_NO_AUDIO=1 \\"
+echo "    $PWD/$bin/horizon-client --resources $PWD/.local/horizon-client/26.3 --offscreen --world smoke --seed 1 \\"
+echo "    --render-distance 4 --world-frames 1500 --timeout-seconds 180 --smoke-report \"\$home/smoke.json\""
+exit $fail
