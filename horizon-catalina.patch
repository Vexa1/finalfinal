+                NSPoint::new(
+                    frame.origin.x + bounds.origin.x.as_f32() as f64,
+                    frame.origin.y + frame.size.height
+                        - bounds.origin.y.as_f32() as f64
+                        - bounds.size.height.as_f32() as f64,
+                ),
+                NSSize::new(
+                    bounds.size.width.as_f32() as f64,
+                    bounds.size.height.as_f32() as f64,
+                ),
+            )
