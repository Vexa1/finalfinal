diff --git a/launcher/Cargo.toml b/launcher/Cargo.toml
index 958e04e..b29b155 100644
--- a/launcher/Cargo.toml
+++ b/launcher/Cargo.toml
@@ -116,3 +116,14 @@ syn = "2"
 
 [profile.release]
 strip = true
+
+# macOS 10.15 (Catalina) support, which GPUI does not have on its own (docs/macos-catalina.md):
+# - objc2-uniform-type-identifiers no longer links UniformTypeIdentifiers.framework (macOS 11+),
+#   which stopped dyld before main on 10.15.
+# - gpui-fast-macos draws drag icons with iconForFileType: instead of UTType (macOS 11+).
+# - gpui-fast-apple compiles its Metal shaders for 10.15, not 12.0 (HORIZON_METAL_MIN_MACOS).
+# Drop these and the folders once GPUI has them. They apply on every platform; only macOS builds them.
+[patch.crates-io]
+objc2-uniform-type-identifiers = { path = "../third_party/objc2-uniform-type-identifiers" }
+gpui-fast-macos = { path = "../third_party/gpui-fast-macos" }
+gpui-fast-apple = { path = "../third_party/gpui-fast-apple" }
